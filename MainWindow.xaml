<Window x:Class="MiniGit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniGit"
        Height="300"
        Width="400">

    <Grid>

<StackPanel Margin="20">

    <Button Content="Open File"
            Height="40"
            Click="OpenFile_Click"/>

    <TextBox Name="EditorBox"
             Margin="0 10 0 0"
             Height="200"
             AcceptsReturn="True"/>



</StackPanel>
<Button Content="Commit"
        Height="40"
        Margin="0 10 0 0"
        Click="Commit_Click"/>
        <ComboBox Name="BranchSelector"
          Height="30"
          Margin="0 10 0 0"/>
          <TextBlock Text="Merge From:"
           Margin="0 10 0 0"/>

<ComboBox Name="MergeBranchSelector"
          Height="30"
          Margin="0 5 0 0"/>
          <Button Content="Create Branch"
        Height="40"
        Margin="0 10 0 0"
        Click="CreateBranch_Click"/>
    </Grid>

</Window>